               (lambda (&rest _) (setq mutated t)))
              ((symbol-function 'gnosis-core-review-session-abort)
               (lambda (&rest _) (setq mutated t)))
              ((symbol-function 'message) #'ignore))
      (gnosis-review-resume)
      (should-not mutated))))

